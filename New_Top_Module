module D_FF(
    input clk,
    input D,
    output reg Q,
    output reg Qbar
    );
    
    always @ (posedge clk) begin
        Q<=D;
        Qbar<=!Q;
    end
endmodule


module Decoder(
    input [3:0]Finite_State_Machine_in,
    input [2:0]bits,
    output reg[6:0] out //this is connected to the 7-seg display.

    );
            
       always @(*)
        begin 
            case(bits)
            
                 0:case(Finite_State_Machine_in)
                    4'b0000: out = 7'b1111111; //this is a special case where Finite_State_Machine_in is 0 and bits is 0, we turn all segments off
                    default: out = 7'b1111111;
                    endcase
                 
                 1:case(Finite_State_Machine_in)   // Level 0  dot = 0, dash = 1        
                     4'b0001: out = 7'b1110000; // T or DASH or 1
                     4'b0000: out = 7'b0110000; // E or Dot or          
                     default: out = 7'b1111111; // ALL SEGMENTS OFF
                 endcase
                 2: case(Finite_State_Machine_in)   // Level 1      
                     4'b0011: out = 7'b0010101; // M               
                     4'b0001: out = 7'b0001001; // N 
                     4'b0010: out = 7'b0001000; // "A" ABCEFG(segments A,B,C,E,F,G are ON )  
                     4'b0000: out = 7'b1111001; // I                
                     default: out = 7'b1111111; // ALL SEGMENTS OFF
                 endcase
                 3: case(Finite_State_Machine_in)   // Level 2      
                         4'b0111: out = 7'b0000001; // O               
                         4'b0011: out = 7'b0100001; // G 
                         4'b0101: out = 7'b0101000; // K  
                         4'b0001: out = 7'b1000010; // D                         
                         4'b0000: out = 7'b0100100; // S               
                         4'b0100: out = 7'b1000001; // U
                         4'b0010: out = 7'b1111010; // R 
                         4'b0110: out = 7'b1010101; // W
                         default: out = 7'b1111111; // ALL SEGMENTS OFF
                 endcase
                 4: case(Finite_State_Machine_in)   // Level 3      
                         4'b1011: out = 7'b0001100; // Q               
                         4'b0011: out = 7'b0010010; // Z 
                         4'b1101: out = 7'b1000100; // Y  
                         4'b0101: out = 7'b0110001; // C                         
                         4'b1001: out = 7'b0110110; // X               
                         4'b0001: out = 7'b1100000; // B  //flipped
                         4'b1110: out = 7'b1000111; // J 
                         4'b0110: out = 7'b0011000; // P   
                         4'b0010: out = 7'b1110001; // L               
                         4'b0100: out = 7'b0111000; // F 
                         4'b1000: out = 7'b1100111; // V  
                         4'b0000: out = 7'b1001000; // H                         
                        default: out = 7'b1111111; // ALL SEGMENTS OFF
                 endcase    
             endcase
         end
endmodule


module Faster_clk(
    input in_clk, 
    output reg out_clk);
	
	reg[32:0] count;

	initial begin
		// initialize everything to zero
		count <= 0;
        out_clk <= 0;
	end
	
	always @(negedge in_clk)
	begin
		// increment count by one
		count = count + 1;
		// if count equals to some big number (that you need to calculate),
		//   then flip the output clk,
		if (count == 100_000) begin
            out_clk <= ~out_clk;
            // Reset count to zero (use non-blocking assignment)
            count <= 0;
        end
	end
endmodule

module Finite_State_Machine(
        input clk,
        input [31:0] Finite_State_Machine_in,
        input [23:0] bits,
        output [6:0] out,
        output reg [7:0] anode       
    );
      
    //these go into Decoder
    reg [3:0] four_bit_number;
    reg [2:0] mux_in;
    
    // instantiate Decoder that decodes the four bit number into the cathode
    Decoder Finite_State_Machine_Decoder1(.Finite_State_Machine_in(four_bit_number),.bits(mux_in),.out(out));
       
    reg [2:0] state; // stores state of Finite_State_Machine , up to 8 states for 8 anodes
    initial begin
		state = 0;
		anode = 8'b11111111;
	end
    
    always @(posedge clk)
	begin
		
		state = state + 1;
		
		case (state)
            0: anode = 8'b11111110; 
            1: anode = 8'b11111101; 
            2: anode = 8'b11111011; 
            3: anode = 8'b11110111;   
            4: anode = 8'b11101111; 
            5: anode = 8'b11011111; 
            6: anode = 8'b10111111; 
            7: anode = 8'b01111111; //left most
            default: anode = 8'b11111111; //all off
        endcase
		
		case (state) //responsible for value into Decoder
            7: four_bit_number = Finite_State_Machine_in[3:0]; // out of leftmost if first inputed
            6: four_bit_number = Finite_State_Machine_in[7:4]; //   
            5: four_bit_number = Finite_State_Machine_in[11:8]; // 
            4: four_bit_number = Finite_State_Machine_in[15:12];// 
            3: four_bit_number = Finite_State_Machine_in[19:16]; //
            2: four_bit_number = Finite_State_Machine_in[23:20]; //
            1: four_bit_number = Finite_State_Machine_in[27:24]; //
            0: four_bit_number = Finite_State_Machine_in[31:28]; //       
            
            default: four_bit_number = 4'b0000; 
        endcase
        
        case (state) //responsible for changing how Decoder works
            7: mux_in = bits[2:0];
            6: mux_in = bits[5:3];
            5: mux_in = bits[8:6];
            4: mux_in = bits[11:9];
            3: mux_in = bits[14:12];
            2: mux_in = bits[17:15];
            1: mux_in = bits[20:18];
            0: mux_in = bits[23:21];
        endcase     
              
	end
    
endmodule

module Morse_to_text(
    input clk,
    input btn1,
    input btn2,
    input btn3,
    input btn4, //reset button
    input btn5,
    output reg [31:0] Finite_State_Machine_in,
    output reg [23:0] bits
);

    reg [3:0] temp_Finite_State_Machine_in;
    reg [1:0] ii;
    reg [2:0] temp_bits;
    
    reg [31:0] all;
    reg [23:0] all_bits; 
    
    reg [2:0] btn3_num; 

    // Previous state registers
    reg prev_btn1, prev_btn2, prev_btn3, prev_btn4, prev_btn5;

    // Initial block to initialize the previous state registers
    initial begin
        prev_btn1 = 0;
        prev_btn2 = 0;
        prev_btn3 = 0;
        prev_btn4 = 0;
        prev_btn4 = 5;
        ii = 0;
        temp_bits = 3'b000;
        temp_Finite_State_Machine_in = 4'b0000;
        all = 0;
        all_bits = 0;
        btn3_num = 3'b000;
    end
    
    always @(posedge clk) begin
        // Update the previous state registers
        prev_btn1 <= btn1;
        prev_btn2 <= btn2;
        prev_btn3 <= btn3;
        prev_btn4 <= btn4;
        prev_btn5 <= btn5;

        if (btn4 && !prev_btn4) begin // Reset on posedge of btn4
            // Reset logic
            ii = 0;
            temp_bits = 3'b000;
            temp_Finite_State_Machine_in = 4'b0000;
            all = 0;
            all_bits = 0;
            btn3_num = 3'b000;
            bits = 0; // so reset clears out anodes visually
        end

        if ((btn1 && !prev_btn1) || (btn2 && !prev_btn2)) begin
            temp_bits = temp_bits + 1;
        end
        
        //acounting for clicking over the limit
        if (temp_bits > 4)begin
            temp_bits = 1;
        end
        
        //accounting for going past the right most anode
        if (btn3_num == 0)begin
            all = 0; all_bits = 0; 
        end
        
        
        //encoding the dots and dashes to 0's and 1's
        if (btn1 && !prev_btn1) begin
            temp_Finite_State_Machine_in[ii] = 0;
            ii = ii + 1;
        end else if (btn2 && !prev_btn2) begin
            temp_Finite_State_Machine_in[ii] = 1;
            ii = ii + 1;
        end else if (btn3 && !prev_btn3) begin 
                
                case (btn3_num)
                    0:begin all[3:0] = temp_Finite_State_Machine_in; all_bits[2:0] = temp_bits;end
                    1:begin all[7:4] = temp_Finite_State_Machine_in; all_bits[5:3] = temp_bits; end
                    2:begin all[11:8] = temp_Finite_State_Machine_in; all_bits[8:6] = temp_bits; end
                    3:begin all[15:12] = temp_Finite_State_Machine_in; all_bits[11:9] = temp_bits; end
                    4:begin all[19:16] = temp_Finite_State_Machine_in; all_bits[14:12] = temp_bits; end
                    5:begin all[23:20] = temp_Finite_State_Machine_in; all_bits[17:15] = temp_bits; end
                    6:begin all[27:24] = temp_Finite_State_Machine_in; all_bits[20:18] = temp_bits; end
                    7:begin all[31:28] = temp_Finite_State_Machine_in; all_bits[23:21] = temp_bits; end
                endcase
                
                
                btn3_num = btn3_num + 1; //increment population index
                
                //assign output to temp registers
                Finite_State_Machine_in = all;
                bits = all_bits;
                
                //re-initialize index variables
                temp_bits = 3'b000;
                temp_Finite_State_Machine_in = 4'b0000;
                ii = 0;

                
                
        end
        
        if(btn5 && !prev_btn5) begin
            if(btn3_num > 0) begin
                btn3_num = btn3_num - 1;
                
                case (btn3_num)
                    0:begin all[3:0] = 0; all_bits[2:0] = 0;end
                    1:begin all[7:4] = 0; all_bits[5:3] = 0; end
                    2:begin all[11:8] = 0; all_bits[8:6] = 0; end
                    3:begin all[15:12] = 0; all_bits[11:9] = 0; end
                    4:begin all[19:16] = 0; all_bits[14:12] = 0; end
                    5:begin all[23:20] = 0; all_bits[17:15] = 0; end
                    6:begin all[27:24] = 0; all_bits[20:18] = 0; end
                    7:begin all[31:28] = 0; all_bits[23:21] = 0; end
                endcase
            
                Finite_State_Machine_in = all;
                bits = all_bits;
            end
        end
    end
endmodule

module pushbutton(
    input button, clk_in,
    output decounce_out
    );
    
    wire clk_out;
    wire Q1, Q2, Q2_bar;
    
    slow_clk utt(clk_in, clk_out);
    D_FF d1(clk_out, button, Q1);
    D_FF d2(clk_out, Q1, Q2);
    
    assign Q2_bar = ~Q2;
    assign decounce_out = Q1 & Q2_bar;
    
endmodule

module slow_clk(
    input clk_in,
    output clk_out
    );
    
    reg [25:0] count = 0;
    reg clk_out;
    
    always @ (posedge clk_in) begin
        count <= count + 1;
        if(count == 12_500_000) begin
            count <= 0;
            clk_out=~clk_out;
        end
    end
endmodule

